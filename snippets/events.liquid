<div class="page-width">
  <div class="grid__wrapper">
    {% for block in section.blocks %}
    <div class="grid__v">
      <div class="image__date">
        <div class="image__wrapper">
          <img src="{{ block.settings.event_image | img_url: 'master' }}" alt="Event Image">
        </div>
        <div class="date__wrapper">
          <p>{{ block.settings.event_date }}</p>
        </div>
      </div>
      <div class="event__content">
        <h4>{{ block.settings.event_title }}</h4>
        <span>{{ block.settings.event_location }}</span>
        <p>{{ block.settings.event_description }}</p>
        <a href="{{ block.settings.event_link }}" target="_blank">{{ block.settings.event_btn }}</a>
      </div>
    </div>
    {% endfor %}
  </div>
</div>