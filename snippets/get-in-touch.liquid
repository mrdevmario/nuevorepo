<style>
  .touch__wrapper h2 {
    color: {{ section.settings.color }};
    font-size: {{ section.settings.font_size }}px;
  }
</style>

<div class="touch__wrapper">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <div class="call__wrapper">
      <div>
        {{ section.settings.call_us }}
      </div>
      <div>
        {{ section.settings.toll_free }}
      </div>
      <div>
        {{ section.settings.toll_free_fax }}
      </div>
    </div>
    <div class="grid__wrapper">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'side_image' %}
          <div class="side__image">
            <img src="{{ block.settings.side_img | img_url: 'master' }}" />
          </div>
          {% when 'contact_form' %}
          <div class="contact__form">
            {% comment %} {% form 'contact' %}
              {{ form.errors | default_errors }}
              {% if form.posted_successfully? %}
                <p class="form__success">Thanks for contacting us! We will get in touch with you shortly.</p>
              {% endif %}

              <div class="names__wrapper">
                <div class="first-name">
                  <label for="first-name">First name<span><sup>*</sup></span></label>
                  <input type="text" name="contact[first_name]" id="first-name" placeholder="First name" required />
                </div>

                <div class="last-name">
                  <label for="last-name">Last name</label>
                  <input type="text" name="contact[last_name]" placeholder="Last name" id="last-name" />
                </div>
              </div>

              <div class="email">
                <label for="email">Email<span><sup>*</sup></span></label>
                <input type="email" name="contact[email]" id="email" placeholder="youremail@address.com" required />
              </div>

              <div class="message">
                <label for="message">Message<span><sup>*</sup></span></label>
                <textarea name="contact[body]" id="message" required placeholder="Your message or question..."></textarea>
              </div>

              <div class="submit">
                <input class="submit__btn" type="submit" value="SEND MESSAGE" />
              </div>
            {% endform %} {% endcomment %}
            <div class="pxFormGenerator" id="X4au-lLFdYTfcY52rCccUg"></div>
          </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>