{{ 'customer-account.css' | asset_url | stylesheet_tag }}

<div class="grid__wrapper">
  <div class="side__bar">
    <div class="tabs__wrapper">
      <div class="tab">
        <img src="{{ 'order-icon.svg' | asset_url }}" alt="Order History">
        <span>View Order History</span>
      </div>
    </div>
    <p>
      <img src="{{ 'logout-icon.svg' | asset_url }}" alt="Logout">
      <span>
        <a href="/account/logout">Log Out</a></span>
    </p>
  </div>
  <div class="order__history">
    <h4 class="header__wrapper">
      Order History
    </h4>
    <div class="header__navigation">
      <div class="sort__options">
        <span>SORT BY:</span>
        <span>Date - Latest</span>
        <span>Date - Oldest</span>
      </div>
      <div class="nec_search nec_desktop">
        <predictive-search class="search-modal__form" data-loading-text="Po ngarkohet...">
          <form action="/search" method="get" role="search" class="search search-modal__form">
            <div class="field">
              <input class="search__input field__input" id="Search-In-Modal" type="search" name="q" value=""
                placeholder="Search" role="combobox" aria-expanded="false" aria-owns="predictive-search-results-list"
                aria-controls="predictive-search-results-list" aria-haspopup="listbox" aria-autocomplete="list"
                autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false">
              <label class="field__label" for="Search-In-Modal">Search</label>
              <input type="hidden" name="options[prefix]" value="last">
              <button class="search__button field__button" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="17" viewBox="0 0 16 17" fill="none">
                  <path
                    d="M13.8067 13.36L11.54 11.1C12.2713 10.1683 12.6681 9.01777 12.6667 7.83334C12.6667 6.7785 12.3539 5.74736 11.7678 4.87029C11.1818 3.99323 10.3489 3.30965 9.37431 2.90598C8.39978 2.50231 7.32742 2.39669 6.29285 2.60248C5.25829 2.80827 4.30798 3.31622 3.5621 4.0621C2.81622 4.80798 2.30827 5.75829 2.10248 6.79285C1.89669 7.82742 2.00231 8.89978 2.40598 9.87431C2.80965 10.8489 3.49323 11.6818 4.37029 12.2678C5.24736 12.8539 6.2785 13.1667 7.33334 13.1667C8.51777 13.1681 9.66831 12.7713 10.6 12.04L12.86 14.3067C12.922 14.3692 12.9957 14.4188 13.077 14.4526C13.1582 14.4864 13.2453 14.5039 13.3333 14.5039C13.4213 14.5039 13.5085 14.4864 13.5897 14.4526C13.671 14.4188 13.7447 14.3692 13.8067 14.3067C13.8692 14.2447 13.9188 14.171 13.9526 14.0897C13.9864 14.0085 14.0039 13.9213 14.0039 13.8333C14.0039 13.7453 13.9864 13.6582 13.9526 13.577C13.9188 13.4957 13.8692 13.422 13.8067 13.36ZM3.33334 7.83334C3.33334 7.04221 3.56793 6.26885 4.00746 5.61106C4.44698 4.95326 5.0717 4.44057 5.8026 4.13782C6.53351 3.83507 7.33777 3.75585 8.1137 3.91019C8.88962 4.06454 9.60235 4.4455 10.1618 5.00491C10.7212 5.56432 11.1021 6.27705 11.2565 7.05297C11.4108 7.8289 11.3316 8.63317 11.0289 9.36407C10.7261 10.095 10.2134 10.7197 9.55562 11.1592C8.89782 11.5987 8.12446 11.8333 7.33334 11.8333C6.27247 11.8333 5.25505 11.4119 4.50491 10.6618C3.75476 9.91162 3.33334 8.8942 3.33334 7.83334Z"
                    fill="#254238"></path>
                </svg>
              </button>
            </div>
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search="">
              <div class="predictive-search__loading-state">
                <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          </form>
        </predictive-search>
      </div>
    </div>
    <div class="order__list">
      {%- if customer.orders.size > 0 -%}
      {% for order in customer.orders %}
      <div class="order__card">
        <div class="header__wrapper {% if order.financial_status == 'paid' and order.fulfillment_status == 'fulfilled' %}order__shipped{% endif %}">
          <div class="order__confirmation">
            <p>
              {% if order.financial_status == 'paid' and order.fulfillment_status == 'fulfilled' %}
                <span class="clr__green round"></span>
                <span>Order Shipped</span>
                <span style="margin-left: 8px;">{{ order.created_at | date: "%Y-%m-%d" }}</span>
              {% elsif order.financial_status == 'paid' %}
                <span class="clr__dark round"></span>
                <span>Order Approved</span>
              {% elsif order.fulfillment_status == 'unfulfilled' %}
                <span class="clr__yellow round"></span>
                <span>Order Placed</span>
              {% endif %}
            </p>
          </div>
          <div class="date">
            <span>Order Date: {{ order.created_at | date: "%Y-%m-%d" }}</span>
          </div>
        </div>
        <div class="order__details">
          <div class="line__items">
            {% for i in order.line_items %}
            <div class="flex__wrapper">
              <div class="image__wrapper">
                <img src="{{ i.image | img_url: 'master' }}" alt="">
              </div>
              <div class="items">
                <p>{{ i.title }}</p>
                <p class="price">{{ i.price | money }}</p>
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="btn__wrapper">
            <a class="btn green dailog_box" href="{{ order.customer_url }}">VIEW ORDER DETAILS</a>
            {% comment %} <span>
              <img src="{{ 'print.svg' | asset_url }}" alt="Print Invoice">
              <a href="#" class="print_btn">Print Invoice</a>
            </span> {% endcomment %}
            {% comment %} <a class="btn blue" href="#">EDIT ORDER DETAILS</a> {% endcomment %}
          </div>
        </div>
      </div>




      <div class="invoice__popup">
        <img class="close__icon" src="{{ 'close__icon.svg' | asset_url }}" alt="Close">
        <div class="grid__wrapperr">
          <div class="columns">
            <h1>Invoice</h1>
            <div>
              <p>
                Order {{ order.order_name }}<br />
                {% if order.po_number %}PO # {{ order.po_number }}<br />{% endif %}
                {{ order.created_at | date: "%B %e, %Y" }}
              </p>
            </div>
          </div>
          <div class="address">
            <strong>From</strong><br />
            <p>{{ shop.name }}</p>
            <p>{{ shop.address | format_address }}</p>
            {% if shop.phone %}{{ shop.phone }}{% endif %}
          </div>
          {% if order.billing_address %}
          <div class="address">
            <strong>Bill to</strong>
            {{ order.billing_address | format_address }}
          </div>
          {% endif %}
          {% if order.shipping_address %}
          <div class="address">
            <strong>Ship to</strong>
            {{ order.shipping_address | format_address }}
            {% if order.shipping_address.phone %}{{ order.shipping_address.phone }}{% endif %}
          </div>
          {% endif %}
        </div>
        <hr />
        <div class="second__wrapper">
          <h2>Order Details</h2>
          <div class="grid__wrapperrr">
            <table class="table-tabular" style="margin: 1em 0 0 0;">
              <thead>
                <tr>
                  <th style="text-align: left;">Qty</th>
                  <th>Item</th>
                  <th style="text-align: left;">Price</th>
                </tr>
              </thead>
              <tbody>
                {% for line_item in order.line_items %}
                <tr>
                  <td>{{ line_item.quantity }}</td>
                  <td style="text-align: center !important;">{{ line_item.title }}
                    {% if line_item.line_level_discount_allocations.size > 0 %}
                    <span class="subduedText">
                      {% for discount_allocation in line_item.line_level_discount_allocations %}
                      <br>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money
                      }})
                      {% endfor %}
                    </span>
                    {% endif %}
                  </td>
                  <td style="text-align: right;">
                    {% if line_item.original_price != line_item.final_price %}
                    <span class="subduedText"><s>{{ line_item.original_price | money }}</s></span>
                    {% endif %}
                    {{ line_item.final_price | money }}
                  </td>
                </tr>
                {% endfor %}
                <tr>
                  <td colspan="2" style="text-align: right;">Subtotal</td>
                  <td style="text-align: right;">{{ order.line_items_subtotal_price | money }}</td>
                </tr>
                {% assign has_shipping_discount = false %}
                {% for discount_application in order.discount_applications %}
                {% if discount_application.target_type == 'shipping_line' %}
                {% assign has_shipping_discount = true %}
                {% endif %}
                {% if discount_application.target_selection == 'all' and discount_application.target_type !=
                'shipping_line'
                %}
                <tr>
                  <td colspan="2" style="text-align: right;">{% if discount_application.title %}<span
                      class="subduedText">{{
                      discount_application.title }}</span>{% endif %}</td>
                  <td style="text-align: right;">-{{ discount_application.total_allocated_amount | money }}</td>
                </tr>
                {% endif %}
                {% endfor %}
                <tr>
                  <td colspan="2" style="text-align: right;">Tax</td>
                  <td style="text-align: right;">{{ order.tax_price | money }}</td>
                </tr>
                {% if order.shipping_address %}
                <tr>
                  <td colspan="2" style="text-align: right;">Shipping</td>
                  <td style="text-align: right;">{% if has_shipping_discount %}FREE{% else %}{{ order.shipping_price |
                    money
                    }}{%
                    endif %}</td>
                </tr>
                {% endif %}
                <tr>
                  <td colspan="2" style="text-align: right;"><strong>Total</strong></td>
                  <td style="text-align: right;"><strong>{{ order.total_price | money }}</strong></td>
                </tr>
                {% if order.net_payment != order.total_net_amount %}
                <tr>
                  <td colspan="2" style="text-align: right;">Total Paid</td>
                  <td style="text-align: right;">{{ order.net_payment | money }}</td>
                </tr>
                {% endif %}
                {% if order.total_refunded_amount > 0 %}
                <tr>
                  <td colspan="2" style="text-align: right;">Total Refunded</td>
                  <td style="text-align: right;">-{{ order.total_refunded_amount | money }}</td>
                </tr>
                {% endif %}
                {% if order.net_payment != order.total_net_amount %}
                <tr>
                  <td colspan="2" style="text-align: right;"><strong>Outstanding Amount</strong></td>
                  <td style="text-align: right;"><strong>{{ order.total_price | minus: order.net_payment | money
                      }}</strong>
                  </td>
                </tr>
                {% endif %}
              </tbody>
            </table>
            {% if transactions.size > 1 %}
            <div>
              <h2>Transaction Details</h2>
              <table class="table-tabular" style="margin: 0 0 1.5em 0;">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Kind</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {% for transaction in transactions %}
                  <tr>
                    <td>{{ transaction.gateway | payment_method }}</td>
                    <td>{{ transaction.amount | money }}</td>
                    <td>{{ transaction.kind }}</td>
                    <td>{{ transaction.status }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
              {% endif %}
              {% if order.note %}
              <h2>Note</h2>
              <p>{{ order.note }}</p>
            </div>
            {% endif %}
            <p style="margin: 0 !important;" class="last__item">If you have any questions, please send an email to
              <u>
                <a href="mailto:order@nesbestflex.com">order@nesbestflex.com</a>
              </u>
              {% comment %} <button class="print__invoice" onclick="window.print();">Print Invoice</button> {% endcomment %}
            </p>
          </div>
        </div>
      </div>




      {% endfor %}
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const printInvoiceLinks = document.querySelectorAll('.dailog_box');
    const invoicePopups = document.querySelectorAll('.invoice__popup');
    const closeButtons = document.querySelectorAll('.close__icon');
    const popupOverlay = document.createElement('div');
    popupOverlay.classList.add('invoice__popup-overlay');
    document.body.appendChild(popupOverlay);

    printInvoiceLinks.forEach(function (link, index) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        invoicePopups.forEach(function (popup) {
          popup.style.display = 'none';
        });

        invoicePopups[index].style.display = 'block';
        popupOverlay.style.display = 'block';
      });
    });

    closeButtons.forEach(function (button) {
      button.addEventListener('click', () => {
        invoicePopups.forEach(function (popup) {
          popup.style.display = 'none';
        });
        popupOverlay.style.display = 'none';
      });
    });

    popupOverlay.addEventListener('click', function () {
      invoicePopups.forEach(function (popup) {
        popup.style.display = 'none';
      });
      popupOverlay.style.display = 'none';
    });

    // Print functionality
    {% comment %} document.querySelectorAll('.print__invoice').forEach(function (button) {
      button.addEventListener('click', function () {
        window.print();
      });
    }); {% endcomment %}
  });
</script>