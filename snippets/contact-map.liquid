<style>
  .contact-map__wrapper h1 {
    font-size: {{ section.settings.font_size }}px;
    color: {{ section.settings.color }};
  }
</style>

<div class="contact-map__wrapper">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
    <hr class="line" />
