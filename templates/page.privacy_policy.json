          }
        },
        "6d827d24-cda4-4f2a-8432-37fd29b83180": {
          "type": "privacy_cont",
          "settings": {
            "tab_id": "credits",
            "cont_class": "",
            "cont_head": "Credits",
            "cont_txt": "<div>\n    <p>All returned items will be inspected upon arrival by a New England Supply specialist. If the inspected item(s) is deemed resellable, the following action will take place depending on your original form of payment. An in-house credit will be applied to your account, refund to your credit card, or mailed refund check.<\/p>\n  <\/div>"
          }
        }
