            "custom_liquid": "<div class=\"kit_include\">\n{{ product.metafields.custom.kit_includes }}\n<\/div>\n<!-- Dropdown for Top Clamp Option -->\n{% assign top_clamp_options = product.metafields.custom.top_clamp | split: \",\" %}\n{% if top_clamp_options.size > 0 %}\n  <div>\n    <label for=\"topClampDropdown\">Select a Top Clamp Option:<\/label>\n    <select id=\"topClampDropdown\" name=\"topClampDropdown\">\n      {% for option in top_clamp_options %}\n        <option value=\"{{ option | strip_newlines | replace: '\"', '' | replace: '[', '' | replace: ']', '' }}\">{{ option | strip_newlines | replace: '\"', '' | replace: '[', '' | replace: ']', '' }}<\/option>\n      {% endfor %}\n    <\/select>\n  <\/div>\n{% endif %}\n\n<!-- JavaScript to Capture Dropdown Value on Form Submission -->\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    var form = document.querySelector('form');\n    var dropdown = document.getElementById('topClampDropdown');\n\n    form.addEventListener('submit', function(event) {\n      if (dropdown) {\n        var selectedOption = dropdown.value;\n        var input = document.createElement('input');\n        input.type = 'hidden';\n        input.name = 'properties[Top Clamp]';\n        input.value = selectedOption;\n        form.appendChild(input);\n      }\n    });\n  });\n<\/script>"
