    "7257c533-ff3c-4b24-a677-68531e02bc59": {
      "type": "career_info",
      "settings": {
        "spec_strip": "NEED A CUSTOM ORDER? TRY OUR CUSTOM CAP BUILDER",
        "heading": "Career OPPORTUNITIES at NECS",
        "info_title": "Working with NECS",
        "info_txt": "NECS is a dynamic and growing\nmanufacturing company specializing in chimney venting systems. With a passion\nfor what we do, we're excited to announce that NECS is now in its 14th year of\nbusiness, marking a dynamic milestone in our journey. With facilities in New England\nand the Mid-Atlantic, we strive to provide top-notch services to our customers\nacross the nation. \nAt NECS, we assist our customers in\ncreating a comprehensive parts list for their custom projects. We seamlessly\nprocess their orders, manufacture the products in-house, and ensure timely\ndelivery through our dedicated NECS trucks. Throughout this process, we\nmaintain and contribute to an enthusiastic and supportive atmosphere. If you\nare someone who shares our enthusiasm and enjoys a fulfilling work experience,\nwe invite you to consider a career with us.",
        "img_1": "shopify://shop_images/Custom_6.jpg",
        "img_2": "shopify://shop_images/IMG_0328-min_1.jpg"
      }
    },
