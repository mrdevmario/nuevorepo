{{ 'get-in-touch.css' | asset_url | stylesheet_tag }}
{% render 'get-in-touch' %}

{% schema %}
{
  "name": "Get In Touch",
  "tag": "section",
  "class": "get-in-touch",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch"
    },

    {
      "type": "color",
      "id": "color",
      "label": "Heading Color",
      "default": "#1E4A7D"
    },

    {
      "type": "range",
      "id": "font_size",
      "min": 18,
      "max": 24,
      "unit": "px",
      "default": 24,
      "label": "Heading Font Size"
    },

    {
      "type": "html",
      "id": "call_us",
      "label": "Call Us"
    },

    {
      "type": "html",
      "id": "toll_free",
      "label": "Toll Free"
    },

    {
      "type": "html",
      "id": "toll_free_fax",
      "label": "Toll Free Fax"
    }
  ],
    "max_blocks": 2,
  	"blocks": [
     {
       "name": "Side Image",
       "type": "side_image",
       "settings": [
         {
           "type": "image_picker",
           "id": "side_img",
           "label": "Side Image"
         }
       ]
     },

     {
       "name": "Contact Form",
       "type": "contact_form",
       "settings": []
     }
  ],
  "presets": [
    {
      "name": "Get In Touch",
      "blocks": [
        {
          "type": "side_image"
        },

        {
          "type": "contact_form"
        }
      ]
    }
  ]
}
{% endschema %}