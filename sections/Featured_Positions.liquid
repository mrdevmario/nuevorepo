    //       }
    //     }
    //   ]
    // });
    
    $(document).ready(function() {
      var $elements = $('.ft_pos_block');
      if ($elements.length > 0) {
        $('.ft_pos_block > .empty-pos').hide();
      } else {
        $('.ft_pos_block > .empty-pos').show();
      }

      var $btns = $('.btn').click(function() {
        if (this.id == 'all') {
          $('.ft_pos_block > div').fadeIn(450);
          if ($elements.length > 0) {
            $('.ft_pos_block > .empty-pos').hide();
          } else {
            $('.ft_pos_block > .empty-pos').show();
          }
        } else {
          var $el = $('.' + this.id).fadeIn(450);
          $('.ft_pos_block > div').not($el).hide();
          if($el.length > 0) {
            $('.ft_pos_block > .empty-pos').hide();
          } else {
            $('.ft_pos_block > .empty-pos').show();
          }
        }
        $btns.removeClass('active');
        $(this).addClass('active');
      })
    });
  </script>

