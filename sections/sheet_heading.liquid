</div>
<div class="spec_block"> 

  {% for block in section.blocks %}
  <div class="spec_item">
    <a href="{{ block.settings.link }}"><img src="https://cdn.shopify.com/s/files/1/0844/6391/1230/files/basil_document-outline.svg?v=1702705156"><h3>{{ block.settings.txt }}</h3></a>
  </div>
 {% endfor %} 

</div>
<div class="specific_paging">
    <div class="specific_list">
       <span class="first">1</span>- <span class="last_spec"></span> of <span class="total_spec"></span>
    </div>
    <a href="#" id="seeMore"><span>Load More</span></a>
</div>
</div>
</div>

{% schema %}
  {
    "name": "sheet_spec",
    "settings": [
     {
        "type":"text",
        "id":"spec_strip",
        "label":"Add Strip Text"
      },
     {
        "type":"html",
        "id":"heading",
        "label":"Add Heading"
      }    
    ],
    "blocks":[
  {
    "type":"text",
    "name":"Spec Sheet",
    "settings":[   
    {
        "type":"url",
        "id":"link",
        "label":"Add Link"
      },
    {
        "type":"text",
        "id":"txt",
        "label":"Add Title"
      }
    ]
  }
  ],
"presets":[
  {
    "name":"Specification Sheets"
  }
]
  }
{% endschema %}

<style> 
.sheet_cont {padding: 64px 2vw 64px 2vw;}
.sheet_cont h2 { color: #19454B; font-family: Poppins; font-size: 64px; font-style: normal; font-weight: 700; line-height: 100%; letter-spacing: -2.56px; text-transform: uppercase; margin: 0;}
.sheet_search { display: flex; padding: 24px; align-items: flex-start; gap: 16px;  border-radius: 4px; background: #F1EFEC; margin: 40px 0; }
.sheet_search .search-modal__form { max-width: 100%;}
.sheet_search .search__input.field__input {height: 39px; border-radius: 50px;padding:8px 24px; }
.sheet_search .field:hover.field:after, .sheet_search .field:before, .sheet_search .field:after { box-shadow: none;}
.sheet_search button.search_btn { display: flex; min-width: 200px; padding: 8px 12px; justify-content: center; align-items: center; gap: 8px; border-radius: 40px; background:#19454B; color:#FFF; font-family: Roboto; font-size: 16px; font-style: normal; font-weight: 800; line-height: 130%; letter-spacing: 0.32px; text-transform: uppercase; border: 1px solid #19454b; }
.sheet_search .field__label {display: none;}
.sheet_search .search__input.field__input::placeholder{opacity:1;color: rgba(0, 0, 0, 0.40); font-family: Roboto;font-size: 18px; font-style: normal; font-weight: 500; line-height: 23px; letter-spacing: -0.36px;position:relative}
.sheet_search button.search__button svg { position: relative; top: -3px;}
.sheet_search .field__input:focus-visible {box-shadow: none;}
.sheet_search .field__input:focus-visible {outline: 0; outline-offset: 0; box-shadow: none;}
.sheet_search .predictive-search__loading-state { display: none;}
.spec_block {display: flex; flex-flow: wrap;gap: 16px 64px;}
.spec_item { width: 47%; display: flex; padding: 24px 40px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC;    height: 88px; }
.spec_item a { display: flex;text-decoration: none;}
.spec_item img { margin-right: 8px;}
.spec_item h3 { color: #19454B; font-family: Roboto; font-size: 18px; font-style: normal; font-weight: 700; line-height: 130%; }
.spec_strip.nec_mobile { color: #F9C001; font-family: Roboto; font-size: 12px; font-style: normal; font-weight: 500; line-height: 140%; display: flex; padding: 16px; text-align: center;justify-content: center; align-items: center; gap: 16px; background: #1E4A7D; }
.nec_mobile{display:none!important;}
#seeMore, .specific_paging{ display:none;}  
@media screen and (min-width:320px) and (max-width:767px){ 
.nec_rtmenu {background: #F9C001;}
.sheet_cont {padding: 24px 5px 24px 5px;}
.sheet_cont h2 {color: #19454B; font-family: Poppins; font-size: 28px; font-style: normal; font-weight: 700; line-height: 30px;  letter-spacing: -1.12px; text-transform: uppercase;}
.sheet_search {margin: 24px 0;    flex-direction: column;}
.sheet_search button.search_btn {min-width: 100%;}
.spec_item { width: 100%; display: flex; padding: 16px 24px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC; height: 72px; }
.spec_item h3{coor: #19454B;  font-family: Roboto; font-size: 12px; font-style: normal; font-weight: 500; line-height: 140%;}
body.specification-sheets sticky-header {border: 0!important;}
.nec_mobile{display:block!important;}
form#searchForm { flex-direction: column;}

}
@media screen and (min-width:320px) and (max-width:389px){ 
.spec_strip.nec_mobile {font-size: 9px;}
.sheet_cont h2 {font-size: 26px;}
}
  
@media screen and (min-width:768px) and (max-width:991px){  
.nec_rtmenu {background: #F9C001;}
.sheet_cont {padding: 50px 5px 50px 5px;}
.sheet_cont h2 {color: #19454B; font-family: Poppins; font-size: 35px; font-style: normal; font-weight: 700; line-height: 40px;  letter-spacing: -1.12px; text-transform: uppercase;}
.sheet_search {margin: 24px 0;}
.spec_item { width: 48.1%; display: flex; padding: 16px 24px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC; height: 72px; }
.spec_item h3{coor: #19454B; font-family: Roboto; font-size: 14px; font-style: normal; font-weight: 500; line-height: 140%;}
.spec_block {gap: 16px 24px;}
.nec_mobile{display:block!important;}
body.specification-sheets sticky-header {border: 0!important;}
}

@media screen and (min-width:992px) and (max-width:1365px){  
.spec_block { gap: 16px 48px;}
.nec_mobile{display:none!important;}
}

@media screen and (max-width:767px){
.spec_item {
    display: none;
}
#seeMore {
    display: flex;
    min-width: 200px;
    padding: 8px 12px;
    justify-content: center;
    align-items: center;
    gap: 8px;
    border-radius: 40px;
    background: #19454B;
    flex: 1 0 0;
    text-decoration: unset;
}
#seeMore span{
    color: #FFF;
    font-family: Roboto;
    font-size: 16px;
    font-style: normal;
    font-weight: 800;
    line-height: 130%; 
    letter-spacing: 0.32px;
    text-transform: uppercase;
}
.spec{
   display:block;
}
.specific_list{
  color: #19454B;
  font-family: Roboto;
  font-size: 18px;
  font-style: normal;
  font-weight: 700;
  line-height: 130%; 
}
.specific_paging {
    display: flex;
    align-items: center;
    gap: 50px;
    margin-top: 25px;
}
}
</style>

{% javascript %}

  $(".spec_item").slice(0,12).show();
  $('.last_spec').text($(".spec_item:visible").length);
  $('.total_spec').text($(".spec_item").length);
  $("#seeMore").click(function(e){
    e.preventDefault();
    $(".spec_item:hidden").slice(0,12).fadeIn("slow");
    var len_spec=$(".spec_item:visible").length;
    $('.last_spec').text($(".spec_item:visible").length);
    if($(".spec_item:hidden").length == 0){
       $("#seeMore").fadeOut("slow");
      }
  });
{% endjavascript %}