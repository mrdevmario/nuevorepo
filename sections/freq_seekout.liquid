<div class="freq_seek page-width">
<div class="resume_block">
  <h2>{{ section.settings.resume_heading }}</h2>
  <p>{{ section.settings.resume_text }}</p>
</div>
</div>

{% schema %}
  {
    "name": "freq_seek",
    "settings": [
     {
        "type":"html",
        "id":"heading",
        "label":"Add Heading"
      },
      {
        "type":"text",
        "id":"resume_heading",
        "label":"Add Resume Block Heading"
      },
      {
        "type":"html",
        "id":"resume_text",
        "label":"Add Resume Block Text"
      }  
    ], 
"presets":[
  {
    "name":"freq_jobs:"
  }
]
  }
{% endschema %}

<style> 
.freq_seek {padding-block: 60px;}
.freq_seek_block { border-radius: 8px; background: #F1EFEC; padding: 24px; display: flex; padding: 24px; flex-direction: column; align-items: flex-start; gap: 16px; align-self: stretch; }
.freq_seek_head h2 { color: #19454B; font-family: Poppins; font-size: 18px; font-style: normal; font-weight: 600; line-height: 140%; letter-spacing: 0.72px; text-transform: uppercase;margin: 0; }
.freq_seek_jobs h3 { color: #19454B; font-family: Roboto; font-size: 18px; font-style: normal; font-weight: 500; line-height: 130%; letter-spacing: -0.36px;margin: 0;  padding: 8px 0; }
.freq_seek_jobs {display: flex; flex-direction: column; align-items: flex-start; gap: 16px; align-self: stretch;}   
.resume_block { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 8px; flex: 1 0 0; align-self: stretch; }
.resume_block h2 { color:  #19454B; font-family: Poppins; font-size: 18px; font-style: normal; font-weight: 600; line-height: 140%; letter-spacing: 0.72px; text-transform: uppercase; margin: 0;}
.resume_block p { color: #19454B; font-family: Roboto; font-size: 18px; font-style: normal; font-weight: 500; line-height: 130%; letter-spacing: -0.36px;margin: 0; }
.resume_block {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 8px;
  text-align: center !important;
}
  
@media screen and (min-width:320px) and (max-width:767px){ 
.freq_seek {grid-template-columns: 100%; gap: 24px; padding-bottom: 24px;}
.resume_block {padding: 0;}
.freq_seek_jobs h3 {padding: 12px 0; border-bottom: 1px solid rgba(0, 0, 0, 0.20); width: 100%; }
.freq_seek_block {padding: 16px;gap: 0;}
.freq_seek_jobs {gap: 0;}
}
@media screen and (min-width:320px) and (max-width:389px){ 
.freq_seek_head h2 {font-size: 15px;margin: 0 0 10px 0;}
.freq_seek_jobs h3 {font-size: 15px;}
.resume_block h2 {font-size: 16px;}
.resume_block p {font-size: 16px;}
}  
@media screen and (min-width:768px) and (max-width:991px){  
.freq_seek_head h2 {font-size: 16px;}
.freq_seek_jobs h3 {font-size: 16px;}
.freq_seek_jobs {gap: 8px;}
.resume_block h2 {font-size: 16px;}
.resume_block p {font-size: 16px;}
.freq_seek {padding-bottom: 48px;}
}
@media screen and (min-width:992px) and (max-width:1365px){  
.freq_seek {padding-bottom: 48px;}
}

@media (max-width: 525px){
 .resume_block {
    gap: 16px !important;
  }
}

</style>

