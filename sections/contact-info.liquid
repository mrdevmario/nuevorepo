{{ 'contact-info.css' | asset_url | stylesheet_tag }}
{% render 'contact-info' %}

{% schema %}
{
  "name": "Contact Information",
  "tag": "section",
  "class": "contact-info",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#F1EFEC"
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 4,
      "max": 8,
      "unit": "px",
      "default": 8,
      "label": "Border Radius"
    }
  ],
    "max_blocks": 2,
  	"blocks": [
     {
       "name": "Hours",
       "type": "hours",
       "settings": [
         {
           "type": "text",
           "id": "heading",
           "label": "Heading",
           "default": "VT & VA Hours of Operation:"
         },

         {
           "type": "text",
           "id": "days_1",
           "label": "Days Block 1"
         },

         {
           "type": "text",
           "id": "time_1",
           "label": "Time Block 1"
         },

         {
           "type": "text",
           "id": "days_2",
           "label": "Days Block 2"
         },

         {
           "type": "text",
           "id": "time_2",
           "label": "Time Block 2"
         },

         {
           "type": "text",
           "id": "days_3",
           "label": "Days Block 3"
         },

         {
           "type": "text",
           "id": "time_3",
           "label": "Time Block 3"
         }
       ]
     },

     {
       "name": "Address",
       "type": "address",
       "settings": [
         {
           "type": "text",
           "id": "heading",
           "label": "Heading",
           "default": "Address:"
         },

         {
           "type": "text",
           "id": "sub_heading_1",
           "label": "Sub Heading 1"
         },

         {
           "type": "html",
           "id": "address_description_1",
           "label": "Address Description"
         },

         {
           "type": "text",
           "id": "sub_heading_2",
           "label": "Sub Heading 2"
         },

         {
           "type": "html",
           "id": "address_description_2",
           "label": "Address Description"
         }
       ]
     }
  ],
  "presets": [
    {
      "name": "Contact Information",
      "blocks": [
        {
          "type": "hours"
        },

        {
          "type": "address"
        }
      ]
    }
  ]
}
{% endschema %}