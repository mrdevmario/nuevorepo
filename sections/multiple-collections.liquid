{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% assign first_collection = section.settings.selected_collections.first %}
{% assign base_collection = collections[first_collection.handle] %}

{% assign storefront_token = 'e20beb154107a1b1903aa6c770483b63' %}

<script>
  window.shopifyStorefrontToken = '{{ storefront_token }}';
</script>

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1 class="page-width__heading text-center">Products</h1>
    <!-- Subfilters -->
    <div class="subfilters-wrapper" style="display: none;">
      <div class="subfilters-section alloy-filters" style="display: none;">
        <div class="subfilters-list" id="alloy-subfilters"></div>
      </div>
      
      <div class="subfilters-section type-filters" style="display: none;">
        <div class="subfilters-list" id="type-subfilters"></div>
      </div>
    </div>

    <div class="sorting-wrapper">
      <div class="sorting-container">
        <span class="sorting-label">Sort by:</span>
        <select id="SortBy" class="sorting-select">
          <option value="featured">Featured</option>
          <option value="best-selling">Best selling</option>
          <option value="title-ascending">Alphabetically, A-Z</option>
          <option value="title-descending">Alphabetically, Z-A</option>
          <option value="price-ascending">Price, low to high</option>
          <option value="price-descending">Price, high to low</option>
          <option value="created-ascending">Date, old to new</option>
          <option value="created-descending">Date, new to old</option>
        </select>
      </div>
    </div>

    <div class="collection-layout">
      <!-- Active filters -->
      <div class="active-filters-wrapper">
        <div class="active-filters" id="active-filters">
          <!-- Active filters will be rendered here -->
        </div>
      </div>
      
      <!-- Filtros laterales -->
      <div class="collection-filters" id="collection-filters">
        <div class="filter-group">
          <div class="filter-options" id="product-type-filters">
            <!-- Los filtros se generarán dinámicamente aquí -->
          </div>
        </div>
      </div>

      <!-- Contenedor principal de productos -->
      <div class="collection-content">
        <div id="ProductGridContainer">
          <div class="collection">
            <div id="product-grid" data-id="{{ section.id }}" class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop">
            </div>
          </div>
          <div id="pagination-container" class="pagination center"></div>
          <div id="loading-indicator" style="display: none">Loading more products...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
class MultiCollectionHandler {
  constructor() {
    // ... tu código existente ...
    
    // OPTIMIZACIONES CRÍTICAS para miles de productos
    this.requestCache = new Map();
    this.debounceTimer = null;
    this.maxProductsPerQuery = 250; // Shopify limit
    this.maxProductsToRender = 1000; // Prevent browser freeze
    this.isLoadingMore = false;
    
    // Virtual scrolling para performance
    this.renderBuffer = 50; // Solo renderizar 50 productos visibles + buffer
    
    this.initialize();
  }

  // OPTIMIZACIÓN 1: Cursor-based pagination para obtener TODOS los productos
  async fetchAllProductsFromCollection(handle) {
    if (this.requestCache.has(handle)) {
      console.log(`Using cached data for collection: ${handle}`);
      return this.requestCache.get(handle);
    }

    console.log(`Fetching ALL products for collection: ${handle}`);
    let allProducts = [];
    let hasNextPage = true;
    let cursor = null;
    let queryCount = 0;

    while (hasNextPage && queryCount < 20) { // Max 20 queries = 5000 products
      const query = `
query getCollectionProducts($handle: String!, $cursor: String) {
  collection(handle: $handle) {
    products(first: 250, after: $cursor) {
      pageInfo {
        hasNextPage
        endCursor
      }
      edges {
        cursor
        node {
          id
          title
          handle
          productType
          featuredImage {
            url(transform: {maxWidth: 200, maxHeight: 200})
            altText
          }
          priceRange {
            minVariantPrice {
              amount
            }
          }
          variants(first: 1) {
            edges {
              node {
                price { amount }
                compareAtPrice { amount }
                metafields(identifiers: [
                  {namespace: "custom", key: "alloy"},
                  {namespace: "custom", key: "liner_type"}
                ]) {
                  key
                  value
                }
              }
            }
          }
          metafields(identifiers: [
            {namespace: "custom", key: "alloy"},
            {namespace: "custom", key: "liner_type"}
          ]) {
            key
            value
          }
          tags
        }
      }
    }
  }
}`;

      try {
        const response = await fetch('/api/2024-01/graphql.json', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shopify-Storefront-Access-Token': this.storefrontToken
          },
          body: JSON.stringify({
            query,
            variables: { handle, cursor }
          })
        });

        const data = await response.json();
        
        if (data.errors) {
          console.error('GraphQL errors:', data.errors);
          break;
        }

        const products = data.data.collection.products.edges.map(edge => {
          const product = edge.node;
          const firstVariant = product.variants.edges[0]?.node;
          
          if (!firstVariant) return null;

          const productAlloy = product.metafields?.find(m => m?.key === 'alloy')?.value || null;
          const productLinerType = product.metafields?.find(m => m?.key === 'liner_type')?.value || null;
          const variantAlloy = firstVariant.metafields?.find(m => m?.key === 'alloy')?.value || null;
          const variantLinerType = firstVariant.metafields?.find(m => m?.key === 'liner_type')?.value || null;
          
          return {
            id: product.id,
            title: product.title,
            handle: product.handle,
            product_type: product.productType,
            featured_image: {
              src: product.featuredImage?.url,
              alt: product.featuredImage?.altText
            },
            variants: [{
              price: parseFloat(firstVariant.price.amount),
              compare_at_price: firstVariant.compareAtPrice ? 
                parseFloat(firstVariant.compareAtPrice.amount) : null
            }],
            metafields: {
              alloy: variantAlloy || productAlloy,
              liner_type: variantLinerType || productLinerType
            },
            tags: product.tags
          };
        }).filter(Boolean);

        allProducts = [...allProducts, ...products];
        
        hasNextPage = data.data.collection.products.pageInfo.hasNextPage;
        cursor = data.data.collection.products.pageInfo.endCursor;
        queryCount++;

        console.log(`Fetched ${products.length} products from ${handle}. Total so far: ${allProducts.length}`);
        
        // Small delay to avoid rate limiting
        if (hasNextPage) {
          await new Promise(resolve => setTimeout(resolve, 100));
        }

      } catch (error) {
        console.error(`Error fetching products for ${handle}:`, error);
        break;
      }
    }

    console.log(`Total products fetched for ${handle}: ${allProducts.length}`);
    this.requestCache.set(handle, allProducts);
    return allProducts;
  }

  // OPTIMIZACIÓN 2: Batch processing y Web Workers (si es posible)
  async processProductsInBatches(products, batchSize = 500) {
    const batches = [];
    for (let i = 0; i < products.length; i += batchSize) {
      batches.push(products.slice(i, i + batchSize));
    }
    return batches;
  }

  // OPTIMIZACIÓN 3: Virtual scrolling para renderizado
  async showPage(page) {
    if (page < 1) return;

    const start = (page - 1) * this.productsPerPage;
    const end = start + this.productsPerPage;
    
    // LÍMITE DE SEGURIDAD: No renderizar más de 1000 productos
    const safeProducts = this.filteredProducts.slice(0, this.maxProductsToRender);
    const pageProducts = safeProducts.slice(start, end);

    if (pageProducts.length > 0) {
      // OPTIMIZACIÓN: Usar DocumentFragment para batch DOM updates
      const fragment = document.createDocumentFragment();
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = pageProducts.map(product => this.createProductCard(product)).join('');
      
      while (tempDiv.firstChild) {
        fragment.appendChild(tempDiv.firstChild);
      }
      
      this.productGrid.innerHTML = '';
      this.productGrid.appendChild(fragment);
      this.currentPage = page;
    }

    this.renderPagination();
    
    // Warning si hay demasiados productos
    if (this.filteredProducts.length > this.maxProductsToRender) {
      console.warn(`⚠️ ${this.filteredProducts.length} products found, showing first ${this.maxProductsToRender} for performance`);
    }
  }

  // OPTIMIZACIÓN 4: Debounce agresivo para filtros
  handleFilterChangeDebounced() {
    if (this.debounceTimer) {
      clearTimeout(this.debounceTimer);
    }
    
    // Delay más largo para miles de productos
    this.debounceTimer = setTimeout(() => {
      this.handleFilterChange();
    }, 300);
  }

  // OPTIMIZACIÓN 5: Lazy loading de metafields
  async setupFilters() {
    try {
      this.showLoading();
      const productTypes = new Set();
      
      // Cargar solo 3-4 colecciones principales para setup inicial
      const mainCollections = this.collections.slice(0, 4);
      
      for (const collection of mainCollections) {
        const products = await this.fetchAllProductsFromCollection(collection.handle);
        products.forEach(product => {
          if (product.product_type) {
            let type = product.product_type;
            if (type.endsWith('Liner')) {
              type = 'Liner';
            } else if (type.endsWith('Kit')) {
              type = 'Liner Kits';
            }
            productTypes.add(type);
          }
        });
      }

      // Cargar resto de colecciones en background
      setTimeout(() => {
        const remainingCollections = this.collections.slice(4);
        remainingCollections.forEach(collection => {
          this.fetchAllProductsFromCollection(collection.handle);
        });
      }, 1000);

      // Resto de setupFilters igual...
      const filterOrderSetting = {{ section.settings.filter_order | json }};
      const orderedFilters = filterOrderSetting.split(/\r?\n/).filter(Boolean);
      const validOrderedFilters = orderedFilters.filter(type => productTypes.has(type));
      const remainingTypes = [...productTypes].filter(type => !orderedFilters.includes(type)).sort();
      const allFilters = [...validOrderedFilters, ...remainingTypes];

      this.filterContainer.innerHTML = `
        <div class="filter-group">
          <div class="filter-group__header" onclick="this.parentElement.classList.toggle('expanded')">
            <h3 class="filter-group__title">Product type</h3>
            <span class="filter-group__toggle">+</span>
          </div>
          <div class="filter-group__content">
            ${allFilters.map(type => `
              <div class="filter-option">
                <label class="filter-checkbox">
                  <input type="checkbox" value="${type}" data-filter="type">
                  <span class="checkbox-custom"></span>
                  <span class="filter-label">${type}</span>
                </label>
              </div>
            `).join('')}
          </div>
        </div>

        <div class="filter-spacer"></div>

        <div class="filter-group">
          <div class="filter-group__header" onclick="this.parentElement.classList.toggle('expanded')">
            <h3 class="filter-group__title">Liner Kit Type</h3>
            <span class="filter-group__toggle">+</span>
          </div>
          <div class="filter-group__content">
            <div class="filter-option">
              <label class="filter-checkbox">
                <input type="checkbox" value="Insert" data-filter="kit-type">
                <span class="checkbox-custom"></span>
                <span class="filter-label">Insert</span>
              </label>
            </div>
            <div class="filter-option">
              <label class="filter-checkbox">
                <input type="checkbox" value="Tee" data-filter="kit-type">
                <span class="checkbox-custom"></span>
                <span class="filter-label">Tee</span>
              </label>
            </div>
          </div>
        </div>
      `;

      const checkboxes = this.filterContainer.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => this.handleFilterChangeDebounced());
      });

    } catch (error) {
      console.error('Error setting up filters:', error);
    } finally {
      this.hideLoading();
    }
  }

  // OPTIMIZACIÓN 6: Usar fetchAllProductsFromCollection en lugar de fetchProductsWithMetafields
  async getFilteredProducts(selectedTypes, selectedKitTypes) {
    try {
      this.showLoading();
      let allProducts = [];
      
      for (const collection of this.collections) {
        const products = await this.fetchAllProductsFromCollection(collection.handle);
        const filteredProducts = products.filter(product => {
          let type = product.product_type;
          if (type.endsWith('Liner')) {
            type = 'Liner';
          }

          const matchesType = selectedTypes.includes(type);
          const matchesKitType = selectedKitTypes.length === 0 || 
            selectedKitTypes.some(kitType => 
              product.tags.some(tag => tag.toLowerCase().includes(kitType.toLowerCase()))
            );

          return matchesType && matchesKitType;
        });
        
        allProducts = [...allProducts, ...filteredProducts];
      }

      return allProducts;
    } catch (error) {
      console.error('Error getting filtered products:', error);
      throw error;
    } finally {
      this.hideLoading();
    }
  }
}

async fetchProductsWithMetafields(handle) {
  const query = `
query getCollectionProducts($handle: String!) {
  collection(handle: $handle) {
    products(first: 250) {
      edges {
        node {
          id
          title
          handle
          productType
          featuredImage {
            url
            altText
            width
            height
          }
          images(first: 2) {
            edges {
              node {
                url
                altText
                width
                height
              }
            }
          }
          priceRange {
            minVariantPrice {
              amount
            }
          }
          variants(first: 5) {
            edges {
              node {
                price {
                  amount
                }
                compareAtPrice {
                  amount
                }
                metafields(identifiers: [
                  {namespace: "custom", key: "alloy"},
                  {namespace: "custom", key: "liner_type"}
                ]) {
                  key
                  value
                }
              }
            }
          }
          metafields(identifiers: [
            {namespace: "custom", key: "alloy"},
            {namespace: "custom", key: "liner_type"}
          ]) {
            key
            value
          }
          tags
        }
      }
    }
  }
}
`;

  try {
    const response = await fetch('/api/2024-01/graphql.json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': this.storefrontToken
      },
      body: JSON.stringify({
        query,
        variables: { handle }
      })
    });

    if (!response.ok) {
      throw new Error(`GraphQL request failed: ${response.statusText}`);
    }

    const data = await response.json();
    
    if (data.errors) {
      throw new Error(`GraphQL errors: ${JSON.stringify(data.errors)}`);
    }

    return data.data.collection.products.edges.map(edge => {
      const product = edge.node;
      const firstVariant = product.variants.edges[0].node;
      
      // Obtener metafields del producto
      const productAlloy = product.metafields?.find(m => m?.key === 'alloy')?.value || null;
      const productLinerType = product.metafields?.find(m => m?.key === 'liner_type')?.value || null;
      
      // Obtener metafields de la primera variante
      const variantAlloy = firstVariant.metafields?.find(m => m?.key === 'alloy')?.value || null;
      const variantLinerType = firstVariant.metafields?.find(m => m?.key === 'liner_type')?.value || null;
      
      return {
        id: product.id,
        title: product.title,
        handle: product.handle,
        product_type: product.productType,
        featured_image: {
          src: product.featuredImage?.url,
          alt: product.featuredImage?.altText,
          width: product.featuredImage?.width,
          height: product.featuredImage?.height
        },
        images: product.images.edges.map(img => ({
          src: img.node.url,
          alt: img.node.altText,
          width: img.node.width,
          height: img.node.height
        })),
        variants: [{
          price: parseFloat(firstVariant.price.amount),
          compare_at_price: firstVariant.compareAtPrice ? 
            parseFloat(firstVariant.compareAtPrice.amount) : null
        }],
        metafields: {
          alloy: variantAlloy || productAlloy,
          liner_type: variantLinerType || productLinerType
        },
        tags: product.tags
      };
    });
  } catch (error) {
    console.error(`Error fetching products for collection ${handle}:`, error);
    throw error;
  }
}

  async setupFilters() {
    try {
      this.showLoading();
      const productTypes = new Set();
      const productsByCollection = new Map();

      // Fetch initial products to set up filter options
      for (const collection of this.collections) {
        const products = await this.fetchProductsWithMetafields(collection.handle);
        productsByCollection.set(collection.handle, products);
        products.forEach(product => {
          if (product.product_type) {
            let type = product.product_type;
            if (type.endsWith('Liner')) {
              type = 'Liner';
            } else if (type.endsWith('Kit')) {
              type = 'Liner Kits';
            }
            productTypes.add(type);
          }
        });
      }

      const filterOrderSetting = {{ section.settings.filter_order | json }};
      const orderedFilters = filterOrderSetting.split(/\r?\n/).filter(Boolean);
      const validOrderedFilters = orderedFilters.filter(type => productTypes.has(type));
      const remainingTypes = [...productTypes].filter(type => !orderedFilters.includes(type)).sort();
      const allFilters = [...validOrderedFilters, ...remainingTypes];

      this.filterContainer.innerHTML = `
        <div class="filter-group">
          <div class="filter-group__header" onclick="this.parentElement.classList.toggle('expanded')">
            <h3 class="filter-group__title">Product type</h3>
            <span class="filter-group__toggle">+</span>
          </div>
          <div class="filter-group__content">
            ${allFilters.map(type => `
              <div class="filter-option">
                <label class="filter-checkbox">
                  <input type="checkbox" value="${type}" data-filter="type">
                  <span class="checkbox-custom"></span>
                  <span class="filter-label">${type}</span>
                </label>
              </div>
            `).join('')}
          </div>
        </div>

        <div class="filter-spacer"></div>

        <div class="filter-group">
          <div class="filter-group__header" onclick="this.parentElement.classList.toggle('expanded')">
            <h3 class="filter-group__title">Liner Kit Type</h3>
            <span class="filter-group__toggle">+</span>
          </div>
          <div class="filter-group__content">
            <div class="filter-option">
              <label class="filter-checkbox">
                <input type="checkbox" value="Insert" data-filter="kit-type">
                <span class="checkbox-custom"></span>
                <span class="filter-label">Insert</span>
              </label>
            </div>
            <div class="filter-option">
              <label class="filter-checkbox">
                <input type="checkbox" value="Tee" data-filter="kit-type">
                <span class="checkbox-custom"></span>
                <span class="filter-label">Tee</span>
              </label>
            </div>
          </div>
        </div>
      `;

      const checkboxes = this.filterContainer.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => this.handleFilterChange());
      });
    } catch (error) {
      console.error('Error setting up filters:', error);
    } finally {
      this.hideLoading();
    }
  }

  async handleFilterChange() {
  try {
    this.showLoading();
    const selectedTypes = Array.from(document.querySelectorAll('input[data-filter="type"]:checked'))
      .map(checkbox => checkbox.value);

    const selectedKitTypes = Array.from(document.querySelectorAll('input[data-filter="kit-type"]:checked'))
      .map(checkbox => checkbox.value);

    this.subfiltersWrapper.style.display = 'none';
    this.alloyFiltersSection.style.display = 'none';
    this.typeFiltersSection.style.display = 'none';

    if (selectedTypes.includes('Liner') || selectedTypes.includes('Liner Kits') || selectedTypes.includes('Components, Adapters, & Fittings')) {
      const filteredProducts = await this.getFilteredProducts(selectedTypes, selectedKitTypes);
      
      // Check which alloys have products based on metafields
      // Always show aluminum for Components category
      const alloyWithProducts = new Set();
      if (selectedTypes.includes('Components, Adapters, & Fittings')) {
        alloyWithProducts.add('aluminum');
      }
      // Add other alloys from metafields
      filteredProducts.forEach(product => {
        if (product.metafields?.alloy) {
          alloyWithProducts.add(product.metafields.alloy.toLowerCase());
        }
      });

      // Show alloy buttons that have products
      const alloyButtons = document.querySelectorAll('#alloy-subfilters .subfilter-tag');
      alloyButtons.forEach(button => {
        const handle = button.dataset.handle;
        button.style.display = alloyWithProducts.has(handle.toLowerCase()) ? 'flex' : 'none';
      });

      if (alloyWithProducts.size > 0) {
        this.subfiltersWrapper.style.display = 'block';
        this.alloyFiltersSection.style.display = 'block';
      }

      // Move type filter logic outside of the alloy check
     if (selectedTypes.includes('Liner Kits') || selectedTypes.includes('Liner')){
        const activeAlloyTags = document.querySelectorAll('#alloy-subfilters .subfilter-tag.active');
        const filteredByAlloys = activeAlloyTags.length > 0 
          ? filteredProducts.filter(product => 
              Array.from(activeAlloyTags).some(tag => 
                product.metafields?.alloy?.toLowerCase() === tag.dataset.handle.toLowerCase()
              )
            )
          : filteredProducts;

        const typeWithProducts = new Set();
        
        // Check each product's liner_type metafield
        filteredByAlloys.forEach(product => {
          if (product.metafields?.liner_type) {
            typeWithProducts.add(product.metafields.liner_type.toLowerCase());
          }
        });

        console.log('Types found:', Array.from(typeWithProducts)); // Debug log

        if (typeWithProducts.size > 0) {
          // Clear existing type filters
          const typeSubfiltersList = document.getElementById('type-subfilters');
          typeSubfiltersList.innerHTML = '';

          // Create a filter tag for each unique type found
          typeWithProducts.forEach(type => {
            const tag = document.createElement('div');
            tag.className = 'subfilter-tag';
            tag.textContent = type.split(' ')
              .map(word => word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
            tag.dataset.handle = type;
            tag.dataset.type = type;
            tag.addEventListener('click', () => this.handleTypeSubfilterClick(tag));
            typeSubfiltersList.appendChild(tag);
          });

          this.typeFiltersSection.style.display = 'block';
          this.subfiltersWrapper.style.display = 'block';
        }
      }
    }

    this.activeFilters = new Set(selectedTypes);
    this.activeKitTypes = new Set(selectedKitTypes);
    await this.loadProducts();
  } catch (error) {
    console.error('Error handling filter change:', error);
  } finally {
    this.hideLoading();
  }
}

  async getFilteredProducts(selectedTypes, selectedKitTypes) {
    try {
      this.showLoading();
      let allProducts = [];
      
      for (const collection of this.collections) {
        const products = await this.fetchProductsWithMetafields(collection.handle);
        const filteredProducts = products.filter(product => {
          // Normalize the product type for Liners
          let type = product.product_type;
          if (type.endsWith('Liner')) {
            type = 'Liner';
          }

          const matchesType = selectedTypes.includes(type);
          const matchesKitType = selectedKitTypes.length === 0 || 
            selectedKitTypes.some(kitType => 
              product.tags.some(tag => tag.toLowerCase().includes(kitType.toLowerCase()))
            );

          return matchesType && matchesKitType;
        });
        
        allProducts = [...allProducts, ...filteredProducts];
      }

      return allProducts;
    } catch (error) {
      console.error('Error getting filtered products:', error);
      throw error;
    } finally {
      this.hideLoading();
    }
  }

  async loadProducts() {
  try {
    this.showLoading();
    this.filteredProducts = [];
    this.productGrid.innerHTML = '';

    let collectionsToFetch = new Set(this.collections.map(c => c.handle));

    const activeAlloyTags = document.querySelectorAll('#alloy-subfilters .subfilter-tag.active');
    const activeTypeTags = document.querySelectorAll('#type-subfilters .subfilter-tag.active');

    activeAlloyTags.forEach(tag => collectionsToFetch.add(tag.dataset.handle));
    activeTypeTags.forEach(tag => collectionsToFetch.add(tag.dataset.handle));

    const results = await Promise.all(
      Array.from(collectionsToFetch).map(handle => this.fetchProductsWithMetafields(handle))
    );

    let filteredProducts = new Set();
    
    results.forEach(products => {
      products.forEach(product => {
        let type = product.product_type;
        if (type.endsWith('Liner')) {
          type = 'Liner';
        }

        const matchesMainFilter = this.activeFilters.size === 0 || this.activeFilters.has(type);

        const matchesAlloyFilters = activeAlloyTags.length === 0 || 
          Array.from(activeAlloyTags).some(tag => {
            const alloyHandle = tag.dataset.handle.toLowerCase();
            return product.metafields?.alloy?.toLowerCase() === alloyHandle;
          });

        const matchesTypeFilters = activeTypeTags.length === 0 || 
          Array.from(activeTypeTags).some(tag => {
            const typeHandle = tag.dataset.handle.toLowerCase();
            return product.metafields?.liner_type?.toLowerCase() === typeHandle;
          });

        const matchesKitTypes = this.activeKitTypes.size === 0 || 
          Array.from(this.activeKitTypes).some(kitType => 
            product.tags.some(tag => tag.toLowerCase().includes(kitType.toLowerCase()))
          );

        if (matchesMainFilter && matchesAlloyFilters && matchesTypeFilters && matchesKitTypes) {
          filteredProducts.add(product);
        }
      });
    });

    this.filteredProducts = Array.from(filteredProducts);
    await this.showPage(1);

  } catch (error) {
    console.error('Error loading products:', error);
  } finally {
    this.hideLoading();
  }
}

  handleAlloySubfilterClick(tag) {
  const wasActive = tag.classList.contains('active');
  
  if (!wasActive) {
    tag.classList.add('active');
    this.activeAlloyFilter = tag.dataset.handle;
  } else {
    tag.classList.remove('active');
    this.activeAlloyFilter = null;
  }
  
  this.loadProducts();
}

  handleTypeSubfilterClick(tag) {
    if (tag.style.display === 'none') return;
    
    const wasActive = tag.classList.contains('active');
    
    if (!wasActive) {
      tag.classList.add('active');
      this.activeTypeFilter = tag.dataset.handle;
    } else {
      tag.classList.remove('active');
      this.activeTypeFilter = null;
    }

    this.loadProducts();
  }

  setupSorting() {
    const sortSelect = document.getElementById('SortBy');
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        this.showLoading();
        this.sortProducts(sortSelect.value);
        this.hideLoading();
      });
    }
  }

  sortProducts(sortBy) {
    this.filteredProducts.sort((a, b) => {
      switch(sortBy) {
        case 'price-ascending':
          return a.variants[0].price - b.variants[0].price;
        case 'price-descending':
          return b.variants[0].price - a.variants[0].price;
        case 'title-ascending':
          return a.title.localeCompare(b.title);
        case 'title-descending':
          return b.title.localeCompare(a.title);
        case 'created-ascending':
          return new Date(a.created_at) - new Date(b.created_at);
        case 'created-descending':
          return new Date(b.created_at) - new Date(a.created_at);
        default:
          return 0;
      }
    });

    this.showPage(1);
  }

  async showPage(page) {
    if (page < 1) return;

    const start = (page - 1) * this.productsPerPage;
    const end = start + this.productsPerPage;
    const pageProducts = this.filteredProducts.slice(start, end);

    if (pageProducts.length > 0) {
      this.productGrid.innerHTML = pageProducts.map(product => this.createProductCard(product)).join('');
      this.currentPage = page;
    }

    this.renderPagination();
  }

  renderPagination() {
    const totalPages = Math.ceil(this.filteredProducts.length / this.productsPerPage);

    this.paginationContainer.innerHTML = `
      <div class="pagination">
        <button class="pagination__button" ${this.currentPage === 1 ? 'disabled' : ''} 
          onclick="multiCollectionHandler.showPage(${this.currentPage - 1})">
          ←
        </button>
        <button class="pagination__button" ${this.currentPage >= totalPages ? 'disabled' : ''} 
          onclick="multiCollectionHandler.showPage(${this.currentPage + 1})">
          →
        </button>
      </div>
    `;
  }
createProductCard(product) {
  const firstVariant = product.variants[0];
  const comparePrice = firstVariant.compare_at_price > firstVariant.price
    ? `<span class="price--compare">${this.formatMoney(firstVariant.compare_at_price)}</span>`
    : '';

  const imageRatio = '{{ section.settings.image_ratio }}';
  const showSecondaryImage = {{ section.settings.show_secondary_image | json }};

  const primaryImage = product.featured_image || (product.images && product.images[0]);
  const secondaryImage = showSecondaryImage && product.images && product.images[1];

  const placeholderImage = 'https://cdn.shopify.com/s/files/1/0844/6391/1230/files/holder.png?v=1754073591'; // ⚠️ Usa tu imagen real

  const imageUrlSmall = primaryImage?.src
    ? `${primaryImage.src.split('?')[0]}?width=200`
    : placeholderImage;

  const imageUrlSmall2x = primaryImage?.src
    ? `${primaryImage.src.split('?')[0]}?width=400`
    : placeholderImage;

  const imageMarkup = `
    <div class="card__media">
      <div class="media media--transparent media--hover-effect">
        <img
          srcset="${imageUrlSmall} 1x, ${imageUrlSmall2x} 2x"
          src="${imageUrlSmall}"
          sizes="(min-width: 1200px) 25vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
          alt="${product.title || 'No image available'}"
          loading="lazy"
          class="motion-reduce"
          width="200"
          height="200"
        >
        ${
          secondaryImage?.src
            ? `
          <img
            srcset="${secondaryImage.src.split('?')[0]}?width=200 1x, ${secondaryImage.src.split('?')[0]}?width=400 2x"
            src="${secondaryImage.src.split('?')[0]}?width=200"
            sizes="(min-width: 1200px) 25vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
            alt="${product.title}"
            loading="lazy"
            class="motion-reduce"
            width="200"
            height="200"
          >
        `
            : ''
        }
      </div>
    </div>
  `;

  return `
    <div class="grid__item">
      <div class="card-wrapper product-card-wrapper underline-links-hover">
        <div class="card card--standard card--media ${imageRatio !== 'adapt' ? `card--${imageRatio}` : ''}">
          <div class="card__inner color-background-2 ratio${imageRatio === 'adapt' && primaryImage ? ` ratio--adapt` : ''}"
            style="${imageRatio === 'adapt' && primaryImage ? `--ratio-percent: ${1 / (primaryImage.width / primaryImage.height) * 100}%;` : ''}">
            ${imageMarkup}
          </div>
          <div class="card__content">
            <div class="card__information">
              ${product.product_type ? `<div class="product-card__category">${product.product_type}</div>` : ''}
              <h3 class="card__heading">
                <a href="/products/${product.handle}" class="full-unstyled-link">
                  ${product.title}
                </a>
              </h3>
              <div class="card-information">
                <div class="price ${firstVariant.compare_at_price > firstVariant.price ? 'price--on-sale' : ''}">
                  <div class="price__regular">
                    <span class="price-item price-item--regular">
                      ${this.formatMoney(firstVariant.price)}
                    </span>
                    ${comparePrice}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  `;
}


  formatMoney(price) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(price);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  window.multiCollectionHandler = new MultiCollectionHandler();
});
</script>

