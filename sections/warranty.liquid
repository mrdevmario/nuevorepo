<div class="warranty_strip nec_mobile">{{ section.settings.spec_strip }}</div>
<div class="warranty page-width">
<div class="warranty_cont">  
<h2>{{ section.settings.heading }}</h2>
<h4>{{ section.settings.warranty_text }}</h4>
{% comment %}<div class="sheet_search"> 
<form id="searchForm" style="width:100%;display:flex;gap: 10px;">
  <div class="field">
                    <input class="search__input field__input" id="searchInput" type="search" value="" placeholder="Search">
                    <label class="field__label" for="Search-In-Modal">Search</label>
                    <input type="hidden" name="options[prefix]" value="last">
                    <button class="search__button field__button" aria-label="Search" type="button" >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
  <path d="M13.8067 13.36L11.54 11.1C12.2713 10.1683 12.6681 9.01777 12.6667 7.83334C12.6667 6.7785 12.3539 5.74736 11.7678 4.87029C11.1818 3.99323 10.3489 3.30965 9.37431 2.90598C8.39978 2.50231 7.32742 2.39669 6.29285 2.60248C5.25829 2.80827 4.30798 3.31622 3.5621 4.0621C2.81622 4.80798 2.30827 5.75829 2.10248 6.79285C1.89669 7.82742 2.00231 8.89978 2.40598 9.87431C2.80965 10.8489 3.49323 11.6818 4.37029 12.2678C5.24736 12.8539 6.2785 13.1667 7.33334 13.1667C8.51777 13.1681 9.66831 12.7713 10.6 12.04L12.86 14.3067C12.922 14.3692 12.9957 14.4188 13.077 14.4526C13.1582 14.4864 13.2453 14.5039 13.3333 14.5039C13.4213 14.5039 13.5085 14.4864 13.5897 14.4526C13.671 14.4188 13.7447 14.3692 13.8067 14.3067C13.8692 14.2447 13.9188 14.171 13.9526 14.0897C13.9864 14.0085 14.0039 13.9213 14.0039 13.8333C14.0039 13.7453 13.9864 13.6582 13.9526 13.577C13.9188 13.4957 13.8692 13.422 13.8067 13.36ZM3.33334 7.83334C3.33334 7.04221 3.56793 6.26885 4.00746 5.61106C4.44698 4.95326 5.0717 4.44057 5.8026 4.13782C6.53351 3.83507 7.33777 3.75585 8.1137 3.91019C8.88962 4.06454 9.60235 4.4455 10.1618 5.00491C10.7212 5.56432 11.1021 6.27705 11.2565 7.05297C11.4108 7.8289 11.3316 8.63317 11.0289 9.36407C10.7261 10.095 10.2134 10.7197 9.55562 11.1592C8.89782 11.5987 8.12446 11.8333 7.33334 11.8333C6.27247 11.8333 5.25505 11.4119 4.50491 10.6618C3.75476 9.91162 3.33334 8.8942 3.33334 7.83334Z" fill="#254238"></path>
</svg>
                    </button>
                  </div>
  <button type="button" class="search_btn" onclick="searchWithinSections()">Search</button>
</form>
</div>{% endcomment %}

<div class="warranty_block"> 
  {% for block in section.blocks %}
  <div class="warranty_item">
    <a href="{{ block.settings.link }}"><img src="https://cdn.shopify.com/s/files/1/0844/6391/1230/files/basil_document-outline.svg?v=1702705156"><h3>{{ block.settings.txt }}</h3></a>
  </div>
 {% endfor %}
</div>
{% comment %}<div class="specific_paging">
    <div class="specific_list">
       <span class="first">1</span>- <span class="last_spec"></span> of <span class="total_spec"></span>
    </div>
    <a href="#" id="seeMore"><span>Load More</span></a>
</div>{% endcomment %}
</div>
</div>

{% schema %}
  {
    "name": "warranty",
    "settings": [
     {
        "type":"text",
        "id":"spec_strip",
        "label":"Add Strip Text"
      },
     {
        "type":"html",
        "id":"heading",
        "label":"Add Heading"
      },
      {
        "type":"html",
        "id":"warranty_text",
        "label":"Add Warranty Text"
      }  
    ],
    "blocks":[
  {
    "type":"text",
    "name":"warranty",
    "settings":[   
    {
        "type":"url",
        "id":"link",
        "label":"Add Link"
      },
    {
        "type":"text",
        "id":"txt",
        "label":"Add Title"
      }
    ]
  }
  ],
"presets":[
  {
    "name":"Warranty"
  }
]
  }
{% endschema %}

<style> 
.warranty_cont {padding: 64px 2vw 64px 2vw;}
.warranty_cont h2 { color: #19454B; font-family: Poppins; font-size: 64px; font-style: normal; font-weight: 700; line-height: 100%; letter-spacing: -2.56px; text-transform: uppercase; margin: 0;}
.warranty_cont h4 { color: #19454b; font-family: Poppins; font-size: 15px; font-style: normal; font-weight: 700; line-height: 18px; text-transform: uppercase; margin-bottom: 40px; }
.warranty_block {display: flex; flex-flow: wrap;gap: 16px 64px;}
.warranty_item { width: 47%; display: flex; padding: 24px 40px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC; height: 88px; }
.warranty_item a { display: flex;text-decoration: none;}
.warranty_item img { margin-right: 8px;}
.warranty_item h3 { color: #19454B; font-family: Roboto; font-size: 18px; font-style: normal; font-weight: 700; line-height: 130%; }
.warranty_strip.nec_mobile { color: #F9C001; font-family: Roboto; font-size: 12px; font-style: normal; font-weight: 500; line-height: 140%; display: flex; padding: 16px; text-align: center;justify-content: center; align-items: center; gap: 16px; background: #1E4A7D; }
.nec_mobile{display:none!important;}
  
@media screen and (min-width:320px) and (max-width:767px){ 
.nec_rtmenu {background: #F9C001;}
.warranty_cont {padding: 24px 5px 24px 5px;}
.warranty_cont h2 {color: #19454B; font-family: Poppins; font-size: 28px; font-style: normal; font-weight: 700; line-height: 30px;  letter-spacing: -1.12px; text-transform: uppercase;}
.warranty_cont h4 {font-size: 10px; line-height: 15px; margin-bottom: 24px;     margin-top: 5px;}
.warranty_item { width: 100%; display: flex; padding: 16px 24px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC; height: 72px; }
.warranty_item h3{coor: #19454B;  font-family: Roboto; font-size: 12px; font-style: normal; font-weight: 500; line-height: 140%;}
body.specification-sheets sticky-header {border: 0!important;}
.nec_mobile{display:block!important;}
}
@media screen and (min-width:320px) and (max-width:389px){ 
.warranty_strip.nec_mobile {font-size: 9px;}
.warranty_cont h2 {font-size: 22px;}
.warranty_cont h4 {font-size: 9px; line-height: 13px; margin-bottom: 20px;}
}  
@media screen and (min-width:768px) and (max-width:991px){  
.nec_rtmenu {background: #F9C001;}
.warranty_cont {padding: 50px 5px 50px 5px;}
.warranty_cont h2 {color: #19454B; font-family: Poppins; font-size: 35px; font-style: normal; font-weight: 700; line-height: 40px;  letter-spacing: -1.12px; text-transform: uppercase;}
.warranty_cont h4 { font-size: 12px;line-height: 18px;margin-bottom: 24px; margin-top: 7px; }
.warranty_item { width: 48.1%; display: flex; padding: 16px 24px; align-items: center; gap: 8px; align-self: stretch; border-radius: 4px; background: #F1EFEC; height: 72px; }
.warranty_item h3{coor: #19454B; font-family: Roboto; font-size: 14px; font-style: normal; font-weight: 500; line-height: 140%;}
.warranty_block {gap: 16px 24px;}
.nec_mobile{display:block!important;}
body.specification-sheets sticky-header {border: 0!important;}
}
@media screen and (min-width:992px) and (max-width:1365px){  
.warranty_block { gap: 16px 48px;}
.nec_mobile{display:none!important;}
}

</style>

