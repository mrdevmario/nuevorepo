<div class="join_team">  
<img class="nec_desktop" src="{{ section.settings.image | img_url:'master' }}">
<img class="nec_mobile" src="{{ section.settings.mobile_image | img_url:'master' }}">
  <div class="join_inner page-width">
     <div class="join_content">
       <h2 class="join_head">{{ section.settings.head }}</h2>
       <p class="join_txt">{{ section.settings.txt }}</p>
       <a href="{{ section.settings.btn_url }}" class="join_btn">{{ section.settings.btn_txt }}</a>
     </div>    
     <div class="join_emt"></div>    
  </div>
</div>
{% schema %}
  {
    "name": "NEC_Join",
    "settings": [
     {
      "type":"image_picker",
      "id":"image",
      "label":"Add Image"  
    },
     {
      "type":"image_picker",
      "id":"mobile_image",
      "label":"Add Mobile Image"  
    },
    {
      "type":"html",
      "id":"head",
      "label":"Add Heading"  
    },
     {
      "type":"html",
      "id":"txt",
      "label":"Add Text"  
    },
     {
      "type":"url",
      "id":"btn_url",
      "label":"Add Button URL"
    },
    {
      "type":"text",
      "id":"btn_txt",
      "label":"Add Button Text"
    }  
    ], 
  "presets":[
  {
    "name":"NEC Join"
  }
  ]
  }
{% endschema %}

<style>
.join_team {position: relative;}
.join_team img {position: absolute; right: 0;top: 46px;}
.join_content {padding: 212px 0;}
h2.join_head { color: var(--State-Blue, #1E4A7D); font-family: Poppins; font-size: 64px; font-style: normal; font-weight: 700; line-height: 100%; letter-spacing: -2.56px; text-transform: uppercase; margin: 0;}
h2.join_head span{color:#F9C001;}
p.join_txt span {font-weight: 600;}
p.join_txt {color: #1B4661; font-family: Roboto; font-size: 18px; font-style: normal; font-weight: 400; line-height: 130%; letter-spacing: -0.36px;    margin: 16px 0;}
a.join_btn { display: inline-block; padding: 16px 32px; justify-content: center; align-items: center; gap: 8px; border-radius: 40px; background: var(--Bright-Green, #39AA6E); color: var(--White, #FFF); font-family: Roboto; font-size: 16px; font-style: normal; font-weight: 800; line-height: 130%; letter-spacing: 0.32px; text-transform: uppercase; text-decoration: none;     margin: 16px 0;}

@media screen and (min-width:320px) and (max-width:767px){
img.nec_mobile {position: relative; width: 100%; top: 0;}
h2.join_head { margin: 0; color: #1E4A7D; font-family: Poppins; font-size: 28px; font-style: normal; font-weight: 700; line-height: 30px; letter-spacing: -1.12px; text-transform: uppercase; text-align:left;}
.join_content {padding: 27px 0; text-align: center;}
p.join_txt {text-align: left;}
}

@media screen and (min-width:768px) and (max-width:991px){
img.nec_mobile {position: relative; width: 100%; top: 0;}
h2.join_head { margin: 0; color: #1E4A7D; font-family: Poppins; font-size: 45px; font-style: normal; font-weight: 700; line-height: 50px; letter-spacing: -1.12px; text-transform: uppercase; text-align:left;}
.join_content {padding: 27px 0; text-align: center;}
p.join_txt {text-align: left;}
}

@media screen and (min-width:992px) and (max-width:1365px){
.join_content {width: 80%;}
h2.join_head {font-size: 49px;}
}
  
@media screen and (min-width:320px) and (max-width:389px){
  a.join_btn {padding: 16px 20px;}
}

  

</style>

