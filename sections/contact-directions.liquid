{{ 'contact-directions.css' | asset_url | stylesheet_tag }}
{% render 'contact-directions' %}

{% schema %}
{
  "name": "Contact Directions",
  "tag": "section",
  "class": "contact-directions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DIRECTIONS"
    },

    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#1E4A7D"
    },

    {
      "type": "range",
      "id": "font_size",
      "min": 24,
      "max": 48,
      "unit": "px",
      "default": 48,
      "label": "Font Size"
    }
  ],
    "max_blocks": 2,
  	"blocks": [
     {
       "name": "Left Column",
       "type": "left_column",
       "settings": [
         {
           "type": "color_background",
           "id": "background",
           "label": "Background",
           "default": "#F1EFEC"
         },

         {
           "type": "range",
           "id": "border_radius",
           "label": "Border Radius",
           "min": 4,
           "max": 8,
           "unit": "px",
           "default": 8
         },

         {
           "type": "text",
           "id": "heading",
           "label": "Heading",
           "default": "Directions for Small Vehicles:"
         },

         {
           "type": "text",
           "id": "sub_heading_1",
           "label": "Sub Heading"
         },

         {
           "type": "html",
           "id": "list_1",
           "label": "List One"
         },

         {
           "type": "text",
           "id": "sub_heading_2",
           "label": "Sub Heading"
         },

         {
           "type": "html",
           "id": "list_2",
           "label": "List Two"
         }
       ]
     },

     {
       "name": "Right Column",
       "type": "right_column",
       "settings": [
         {
           "type": "color_background",
           "id": "background",
           "label": "Background",
           "default": "rgba(249, 192, 1, 0.20)"
         },

         {
           "type": "range",
           "id": "border_radius",
           "label": "Border Radius",
           "min": 4,
           "max": 8,
           "unit": "px",
           "default": 8
         },

         {
           "type": "text",
           "id": "heading",
           "label": "Heading",
           "default": "Directions for Trucks:"
         },

        {
           "type": "text",
           "id": "sub_heading_1",
           "label": "Sub Heading"
         },

         {
           "type": "html",
           "id": "list_1",
           "label": "List One"
         },

          {
           "type": "text",
           "id": "sub_heading_2",
           "label": "Sub Heading"
         },

         {
           "type": "html",
           "id": "list_2",
           "label": "List Two"
         }
       ]
     }
  ],
  "presets": [
    {
      "name": "Contact Directions",
      "blocks": [
        {
          "type": "left_column"
        },

        {
          "type": "right_column"
        }
      ]
    }
  ]
}
{% endschema %}