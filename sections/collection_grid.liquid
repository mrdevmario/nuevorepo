a.cgrid_btn { padding: 16px 32px; font-size: 16px; text-transform: uppercase; text-decoration: none; margin: 16px 0; }  
.collection_main {gap: 24px; width: 100%;align-items: center; justify-content: center; flex-wrap: wrap; padding: 0;}
.collection_block .prod-img img {min-width: 149px; height: 149px; border-radius: 4px;}
.collect_title h3 { font-family: Roboto; margin: 20px 0 0 0; min-height: 40px; display: flex; align-items: center; justify-content: center; color: #19454B; text-align: center; font-size: 14.858px; font-style: normal; font-weight: 700; line-height: 120%; }
.cgrid_bottom h4.text_1 {color: #39AA6E; text-align: center; font-family: Poppins; font-size: 18px; font-style: normal; font-weight: 700; line-height: 20px; text-transform: uppercase; margin-bottom: 12px!important; }
.cgrid_bottom h3.text_2 {color: #1E4A7D; text-align: center; font-family: Poppins; font-size: 28px; font-style: normal; font-weight: 700; line-height: 30px; letter-spacing: -1.12px; text-transform: uppercase;margin-top: 0; }
}
  
@media screen and (min-width:768px) and (max-width:991px){  
