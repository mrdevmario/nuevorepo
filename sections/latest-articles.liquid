{{ 'latest-articles.css' | asset_url | stylesheet_tag }}
{% render 'latest-articles' %}

{% schema %}
{
  "name": "Latest Articles",
  "tag": "section",
  "class": "latest-articles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Blog Heading"
    },

    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Latest Articles"
    }
  ],
  	"enabled_on": {
    "templates": ["blog"]
  }
}
{% endschema %}